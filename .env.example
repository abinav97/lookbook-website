# Copy to .env.local for development. Never commit real values.

# Required for live verdicts on /before-you-buy. Server-side only.
ANTHROPIC_API_KEY=

# Kill switch: set to "false" to pause live verdicts (demos keep working).
ADVISOR_ENABLED=true

# Request caps (see src/lib/advisor/limits.ts for the spend math).
ADVISOR_DAILY_CAP=40
ADVISOR_IP_CAP=8
ADVISOR_LIFETIME_CAP=500

# Local tagging tool (never built into production).
ENABLE_ADMIN=false

# Product-image generation pipeline (scripts/generate-images.mjs).
OPENAI_API_KEY=
